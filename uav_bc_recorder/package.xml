<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_bc_recorder</name>
  <version>0.1.0</version>
  <description>Unified intercept experiment telemetry, resource capture, and summaries</description>
  <maintainer email="verser@example.com">verser</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>uav_common_msg</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>